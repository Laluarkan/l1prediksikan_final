{
  "expo": {
    "name": "Prediksikan",
    "slug": "L1prediksikan",
    "scheme": "l1prediksikan",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "id.prediksikan.app",
      "buildNumber": "6"
    },
    "android": {
      "package": "id.prediksikan.app",
      "versionCode": 6,
      "adaptiveIcon": {
        "backgroundColor": "#0F172A",
        "foregroundImage": "./assets/logo.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "allowBackup": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-status-bar",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1074921761810-iaubtmm76ghmv9dq3vhmeegfi80co25a"
        }
      ],
      "expo-sharing",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "92d57d48-f2ba-4a14-9c14-b58c4f6f9950"
      }
    }
  }
}
